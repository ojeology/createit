{
  "appId": "com.createit.app",
  "appName": "CreateIt",
  "webDir": "www",
  "server": {
    "url": "https://createit-icu7.onrender.com",
    "androidScheme": "https"
  },
  "backgroundColor": "#0a0b0e",
  "android": {
    "backgroundColor": "#0a0b0e",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#0a0b0e",
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true,
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true,
      "style": "dark"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#0a0b0e"
    }
  }
}